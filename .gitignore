# Shared ignores for the SOT Online monorepo.
# Keep package-specific rules in frontend/.gitignore and backend/.gitignore.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.p12
*.key
credentials.json
service-account*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Tests and coverage
coverage/
.nyc_output/
*.lcov

# Shared build and cache artifacts
dist/
build/
out/
.tmp/
.temp/
.cache/
.turbo/
*.tsbuildinfo

# OS
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors and IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~
.project
.classpath
.settings/

# Local tooling
.eslintcache
.stylelintcache
.parcel-cache
.history/
.local/
